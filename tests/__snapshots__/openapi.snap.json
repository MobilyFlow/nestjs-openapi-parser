  "components": {
    "schemas": {
      "MaintenanceWindow": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "reason"
        ],
        "description": "Orphan interface — no endpoint reaches it. Force-included via the\n`additionalModels` string form to prove non-class models can be pinned."
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ],
        "description": "Shape of an error response body. No endpoint returns it directly — it's\nforce-included via `additionalModels` and referenced by the `buildResponses`\nhook for error status codes."
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "The user email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number"
          },
          "userId": {
            "type": "string",
            "description": "The user ID"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "userId"
        ]
      },
      "HealthStatusDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "uptimeSeconds": {
            "type": "number"
          }
        },
        "required": [
          "ok",
          "uptimeSeconds"
        ]
      },
      "SystemStatus": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us-east",
              "eu-west",
              "asia"
            ]
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceHealth"
            }
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "Seconds since the process started."
          }
        },
        "required": [
          "region",
          "services",
          "uptimeSeconds"
        ],
        "description": "Aggregated system status — returned as an `interface` with `extends` heritage\nand a nested array of `$ref`d models."
      },
      "StatusSummary": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/SystemStatus"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string",
            "description": "Optional operator note."
          },
          "meta": {
            "type": "object",
            "properties": {
              "degraded": {
                "type": "boolean"
              }
            },
            "required": [
              "degraded"
            ]
          }
        },
        "required": [
          "status",
          "checkedAt",
          "meta"
        ],
        "description": "A `type` alias over an object literal — references an interface, a `Date`, an\noptional field and an anonymous inline object."
      },
      "CreatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "body": {
            "type": "string"
          },
          "authorId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED"
            ]
          }
        },
        "required": [
          "title",
          "body",
          "authorId"
        ]
      },
      "BlogPost": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "authorId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED"
            ]
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "body",
          "authorId",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "description": "A blog post authored by a user."
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "description": "The user's contact email."
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "USER"
            ]
          },
          "bio": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "createdAt",
          "updatedAt"
        ],
        "description": "A registered user."
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "USER"
            ]
          },
          "bio": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "name",
          "role",
          "password"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "USER"
            ]
          },
          "bio": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "ServiceHealth": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Service identifier."
          },
          "healthy": {
            "type": "boolean"
          },
          "latencyMs": {
            "type": "number",
            "description": "Round-trip latency in milliseconds, when measured."
          }
        },
        "required": [
          "name",
          "healthy"
        ],
        "description": "Health of a single downstream service."
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Getting Started",
      "description": "Welcome to the **Example API**. This page is a standalone Markdown document\nrendered ahead of the API reference via `pages` in `nestparser.config.ts`.\n\n## Authentication\n\nMost endpoints require a bearer token:\n\n```http\nAuthorization: Bearer <your-token>\n```\n\nEndpoints marked public (e.g. login, health) need no token.\n\n## Conventions\n\n- Every response is wrapped in a `{ success, message, data }` envelope.\n- List endpoints return a `pagination` object alongside `data`.\n"
    },
    {
      "name": "Auth",
      "description": "This controller manage auth"
    },
    {
      "name": "System Health"
    },
    {
      "name": "Posts"
    },
    {
      "name": "Users"
    }
  ],
  "x-tagGroups": [
